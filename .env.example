# Copy to .env (never commit it). Prefer *_FILE for every secret in production.

# ---- Bitwarden / Vaultwarden ----
BW_SERVER=https://vault.bitwarden.com
# For a self-hosted Vaultwarden: BW_SERVER=https://vault.example.com
BW_EMAIL=you@example.com
# Master password. In production use BW_PASSWORD_FILE=/run/secrets/bw_password instead.
BW_PASSWORD=change-me
# Optional personal API key (avoids password grant / captchas on bitwarden.com):
# BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_CLIENTSECRET_FILE=/run/secrets/bw_client_secret

# ---- Telegram ----
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/tg_token in production.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_OWNER_USER_ID=11111111
# Optional: deliver prompts to a different chat than the owner's private chat.
# TELEGRAM_OWNER_CHAT_ID=11111111

# ---- Agents (per-agent bearer tokens, min 16 chars each) ----
# name:token pairs, comma-separated. Generate with: openssl rand -hex 24
BWGATE_AGENT_TOKENS=deployer:REPLACE_WITH_openssl_rand_hex_24,ci:REPLACE_WITH_ANOTHER

# ---- Server / policy ----
BWGATE_ADDR=127.0.0.1:8099
BWGATE_TRANSPORT=http               # http | stdio | both
BWGATE_APPROVAL_TIMEOUT_SEC=120
BWGATE_LIST_UNGATED=true            # allow search_items without approval
BWGATE_MAX_PENDING_PER_AGENT=3
BWGATE_MAX_PENDING_TOTAL=20
BWGATE_RATE_LIMIT_PER_MIN=30
BWGATE_SYNC_INTERVAL_SEC=900
# Comma-separated globs; deny wins over allow. Empty allowlist = allow all.
# BWGATE_ALLOWLIST=GitHub*,deploy/*
# BWGATE_DENYLIST=AWS prod,root-*
BWGATE_AUDIT_LOG=/var/lib/bwgate/audit.log
